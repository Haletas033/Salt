@as { standalone };

@externC {
        void printf(i8* fmt, ...)
};

@requires { IO, Memory, File };

%i32 main(void) {
        %FILE* f = file_open("test.txt", "r");
        %FileData* file_data = file_read_all(f);
        printf("%.*s", file_data->size, file_data->data);
        file_close(f);
        return { SUCCESS };
}