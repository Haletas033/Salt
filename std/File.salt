@as { library };

#define SEEK_SET 0
#define SEEK_CUR 1
#define SEEK_END 2

%struct FILE {};

@externC {
        FILE* fopen(i8* path, i8* mode),
        void fclose(FILE* stream),
        i32 fseek(FILE* stream, i64 offset, i32 whence),
        i64 ftell(FILE* stream),
        i32 fprintf(FILE* stream, i8* fmt, ...),
        i64 fread(void* ptr, i64 size, i64 nmemb, FILE* stream)
};

@requires { Memory };

%struct FileData {
        %i64 .size;
        %i8* .data;
};

%FILE* file_open(i8* path, i8* mode) {
        return fopen(path, mode);
}

%void file_close(FILE* stream) {
        return { fclose(stream) };
}

%i64 get_file_size(FILE* stream) {
        if (fseek(stream, 0, SEEK_END) != 0) {
                return { 0-1 };
        }

        %i64 size = ftell(stream);

        if (fseek(stream, 0, SEEK_SET) != 0) {
                return { 0-1 };
        }

        return { size };
}

%i8 file_exists(i8* path) {
        %FILE* stream = file_open(path, "r");
        if (stream == nullptr) {
                return { false };
        }
        file_close(stream);
        return { true };
}

%FileData* file_read(FILE* stream, i64 count) {
        %FileData* file_data = alloc(sizeof(FileData));
        %i8* buf = alloc(count);
        file_data->size = fread(buf, 1, count, stream);
        file_data->data = buf;
        return { file_data };
}

%FileData* file_read_all(FILE* stream) {
        %FileData* file_data = alloc(sizeof(FileData));
        %i64 size = get_file_size(stream);
        %i8* buf = alloc(size);
        file_data->size = fread(buf, 1, size, stream);
        file_data->data = buf;
        return { file_data };
}

%i32 file_write(FILE* stream, i8* content) {
        return { fprintf(stream, "%s", content) };
}

